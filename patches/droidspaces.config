# ============ Droidspaces (auto-generated) ============
# IPC
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Namespaces
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_USER_NS=y

# Device filesystem
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Cgroup extra
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y

# Docker/NAT network support
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# tmpfs xattr (NixOS)
CONFIG_TMPFS_XATTR=y

# KernelSU-Next
CONFIG_KSU=y
